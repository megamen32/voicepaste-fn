{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri/tauri.conf.json",
  "productName": "VoicePaste",
  "version": "2.0.0",
  "identifier": "com.bezrabotnyi.voicepaste",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "VoicePaste",
        "width": 58,
        "height": 38,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "focus": false
      },
      {
        "label": "record",
        "title": "VoicePaste Record",
        "url": "record.html",
        "width": 400,
        "height": 350,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "transparent": false,
        "focus": true
      },
      {
        "label": "settings",
        "title": "VoicePaste Settings",
        "url": "settings.html",
        "width": 1040,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": true,
        "resizable": true,
        "visible": false,
        "transparent": false,
        "focus": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "id": "main-tray",
      "tooltip": "VoicePaste"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "modifier_monitor",
      "native_stt"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
